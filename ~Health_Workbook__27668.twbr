      <aliases enabled='yes' />
      <column caption='Address' datatype='string' name='[ADDRESS]' role='dimension' type='nominal' />
      <column caption='BASE COST (procedures.csv1)' datatype='integer' name='[BASE_COST (procedures.csv1)]' role='measure' type='quantitative' />
      <column caption='Base Cost' datatype='integer' name='[BASE_COST]' role='measure' type='quantitative' />
      <column caption='Base Encounter Cost' datatype='real' name='[BASE_ENCOUNTER_COST]' role='measure' type='quantitative' />
      <column caption='Birthdate' datatype='date' name='[BIRTHDATE]' role='dimension' type='ordinal' />
      <column caption='Birthplace' datatype='string' name='[BIRTHPLACE]' role='dimension' type='nominal' />
      <column datatype='string' name='[CITY (organizations.csv)]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[CITY (payers.csv)]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='City' datatype='string' name='[CITY]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='integer' name='[CODE (procedures.csv)]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[CODE (procedures.csv1)]' role='dimension' type='ordinal' />
      <column caption='Code' datatype='integer' name='[CODE]' role='dimension' type='ordinal' />
      <column caption='County' datatype='string' name='[COUNTY]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
      <column caption='Admitted Metric' datatype='integer' name='[Calculation_1901373517557761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [START] : COUNTD([PATIENT])}' />
      </column>
      <column caption='Stay Duration' datatype='integer' name='[Calculation_1901373517942786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [START], [STOP])' />
      </column>
      <column caption='Count of Procedures' datatype='boolean' name='[Calculation_1901373546045443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Description], &quot;procedure&quot;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Procedure Coverage Status' datatype='string' name='[Calculation_1901373546524676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1901373546045443] THEN &#13;&#10;    IF [PAYER_COVERAGE] &gt; 0 THEN &quot;Covered by Insurance&quot; ELSE &quot;Not Covered by Insurance&quot; END&#13;&#10;ELSE&#13;&#10;    &quot;Not a procedure&quot;&#13;&#10;END' />
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_1901373547401221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [BIRTHDATE], TODAY())' />
      </column>
      <column caption='Age Category' datatype='string' name='[Calculation_1901373549228038]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1901373547401221] &gt;= 0 AND [Calculation_1901373547401221] &lt; 10 THEN &quot;0-9&quot;&#13;&#10;ELSEIF [Calculation_1901373547401221] &gt;= 10 AND [Calculation_1901373547401221] &lt; 20 THEN &quot;10-19&quot;&#13;&#10;ELSEIF [Calculation_1901373547401221] &gt;= 20 AND [Calculation_1901373547401221] &lt; 30 THEN &quot;20-29&quot;&#13;&#10;ELSEIF [Calculation_1901373547401221] &gt;= 30 AND [Calculation_1901373547401221] &lt; 40 THEN &quot;30-39&quot;&#13;&#10;ELSEIF [Calculation_1901373547401221] &gt;= 40 AND [Calculation_1901373547401221] &lt; 50 THEN &quot;40-49&quot;&#13;&#10;ELSEIF [Calculation_1901373547401221] &gt;= 50 AND [Calculation_1901373547401221] &lt; 60 THEN &quot;50-59&quot;&#13;&#10;ELSEIF [Calculation_1901373547401221] &gt;= 60 AND [Calculation_1901373547401221] &lt; 70 THEN &quot;60-69&quot;&#13;&#10;ELSEIF [Calculation_1901373547401221] &gt;= 70 AND [Calculation_1901373547401221] &lt; 80 THEN &quot;70-79&quot;&#13;&#10;ELSEIF [Calculation_1901373547401221] &gt;= 80 AND [Calculation_1901373547401221] &lt; 90 THEN &quot;80-89&quot;&#13;&#10;ELSE &quot;90+&quot;&#13;&#10;END' />
      </column>
      <column caption='Admission Status' datatype='string' name='[Calculation_1901373549326343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1901373546045443] = True THEN &quot;Admitted&quot;&#13;&#10;ELSE &quot;Not Admitted&quot; END' />
      </column>
      <column caption='Latest Encounter Date' datatype='datetime' name='[Calculation_1901373549965320]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [PATIENT] : MAX([START]) }' />
      </column>
      <column caption='Filter to the Latest Date' datatype='integer' name='[Calculation_1901373551943690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [START] = [Calculation_1901373549965320] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Is Alive?' datatype='string' name='[Calculation_1901373552291851]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([DEATHDATE]) THEN &apos;Alive&apos; ELSE &quot;Deceased&quot; END' />
      </column>
      <column caption='Clean First' datatype='string' name='[Calculation_1901373555359757]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE([FIRST], &apos;[^a-zA-Z]&apos;, &apos;&apos;)' />
      </column>
      <column caption='Clean Last' datatype='string' name='[Calculation_1901373556088846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE([LAST], &apos;[^a-zA-Z]&apos;, &apos;&apos;)' />
      </column>
      <column caption='Full Name' datatype='string' name='[Calculation_1901373556523023]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([PREFIX], &apos;&apos;) + &apos; &apos; + [Calculation_1901373555359757] + &apos; &apos; + [Calculation_1901373556088846]' />
      </column>
      <column caption='Deathdate' datatype='date' name='[DEATHDATE]' role='dimension' type='ordinal' />
